# H3 2-box 토폴로지 (single source of truth, 참조용)
# proxy-up.sh가 source함. 박스별 serving 스크립트는 localhost 기본값 그대로 사용.
SPARK_VLLM_HOST=spark1
SPARK_COMFY_HOST=spark2-p1-r0
H3_PORT=8000
COMFY_PORT=8188
PROXY_LISTEN=8188
# CX7 패브릭 대역 + 타겟 IP 강제 지정(미지정 시 COMFY_HOST를 resolve).
# proxy-up.sh는 resolve된 IP가 이 대역이 아니면 중단한다.
CX7_SUBNET=192.168.102.
# SPARK_COMFY_IP=192.168.102.2
# 양산 결과 루트 (smoke·양산 스크립트 기본 저장처. 빈값이면 스크립트별 로컬).
RESULTS_ROOT=/rosenas/data/AIML/comfyui/results
